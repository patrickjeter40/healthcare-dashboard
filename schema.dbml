// Current PostgreSQL schema after Alembic revision 20260929_06.
// Documentation only: Alembic remains the source of truth for database changes.

Project healthcare_dashboard {
  database_type: 'PostgreSQL'
  Note: 'Patient management take-home. UUIDs are generated by the application; application validation and soft-delete rules are described in notes, not represented as additional database constraints.'
}

Table patients {
  id uuid [not null, note: 'Application-generated UUID; no database UUID default.']
  first_name varchar(100) [not null]
  last_name varchar(100) [not null]
  date_of_birth date [not null, note: 'Age is calculated on read. Future dates are rejected by application validation.']
  email varchar(320) [null, note: 'Intentionally nonunique; patients may share contact details.']
  phone varchar(40) [null]
  blood_type_id uuid [null]
  status_id uuid [not null, note: 'Required lookup identity; API accepts stable status codes. No database default.']
  last_visit_at timestamptz [null, note: 'Application requires timezone-aware input and rejects future visits.']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`, note: 'Updated by SQLAlchemy/API patient edits and soft deletion. No database update trigger; note changes do not advance this timestamp.']
  deleted_at timestamptz [null, note: 'Soft deletion. Application queries exclude deleted patients and reject writes to them.']

  indexes {
    id [pk, name: 'pk_patients']
  }

  checks {
    `length(btrim(first_name)) > 0` [name: 'ck_patients_first_name_not_blank']
    `length(btrim(last_name)) > 0` [name: 'ck_patients_last_name_not_blank']
  }

  Note: 'A patient can have zero or many allergy selections, condition selections, and notes. Status is independent of soft deletion. This stores the current profile, not a historical audit trail.'
}

Table allergens {
  id uuid [not null, note: 'Application-generated UUID; no database UUID default.']
  name varchar(120) [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    id [pk, name: 'pk_allergens']
    name [unique, name: 'uq_allergens_name']
    (`lower(btrim(name))`) [unique, name: 'uq_allergens_normalized_name']
  }

  checks {
    `length(btrim(name)) > 0` [name: 'ck_allergens_name_not_blank']
    `name = btrim(name)` [name: 'ck_allergens_name_trimmed']
  }

  Note: 'Small seeded, read-only reference catalog. Exact-name uniqueness and normalized-name uniqueness are both enforced. No synonym matching or clinical terminology integration.'
}

Table conditions {
  id uuid [not null, note: 'Application-generated UUID; no database UUID default.']
  name varchar(120) [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    id [pk, name: 'pk_conditions']
    name [unique, name: 'uq_conditions_name']
    (`lower(btrim(name))`) [unique, name: 'uq_conditions_normalized_name']
  }

  checks {
    `length(btrim(name)) > 0` [name: 'ck_conditions_name_not_blank']
    `name = btrim(name)` [name: 'ck_conditions_name_trimmed']
  }

  Note: 'Small seeded, read-only reference catalog. Not clinically comprehensive. Each condition can be associated with zero or many patients.'
}

Table patient_allergies {
  patient_id uuid [not null]
  allergen_id uuid [not null]

  indexes {
    (patient_id, allergen_id) [pk, name: 'pk_patient_allergies']
  }

  Note: 'Many-to-many association. Composite primary key prevents duplicate selections. Soft-deleting a patient retains the row; explicitly removing a selection deletes it. An empty collection means nothing documented, not a confirmed negative assessment.'
}

Table patient_conditions {
  patient_id uuid [not null]
  condition_id uuid [not null]

  indexes {
    (patient_id, condition_id) [pk, name: 'pk_patient_conditions']
  }

  Note: 'Many-to-many association. Composite primary key prevents duplicate selections. No synthetic ID or association timestamps. Retained on patient soft deletion; removed when the selection is explicitly cleared.'
}

Table patient_notes {
  id uuid [not null, note: 'Application-generated UUID; no database UUID default.']
  patient_id uuid [not null]
  content text [not null, note: 'Application limit: 5000 characters. Database enforces nonblank content, not that length limit.']
  recorded_at timestamptz [not null, default: `now()`, note: 'Supplied clinical timestamp. Application rejects timezone-free or future input; omitted input defaults to current UTC time.']
  created_at timestamptz [not null, default: `now()`, note: 'Insertion time, distinct from supplied recorded time.']
  deleted_at timestamptz [null, note: 'Soft deletion. Excluded from active note lists and summaries.']

  indexes {
    id [pk, name: 'pk_patient_notes']
    patient_id [name: 'ix_patient_notes_patient_id']
    recorded_at [name: 'ix_patient_notes_recorded_at']
  }

  checks {
    `length(btrim(content)) > 0` [name: 'ck_patient_notes_content_not_blank']
  }

  Note: 'Each note belongs to exactly one patient. Patients can have zero or many notes. Notes remain when the patient is soft-deleted.'
}

// Infrastructure table, maintained by Alembic rather than application models.
Table alembic_version {
  version_num varchar(32) [not null]

  indexes {
    version_num [pk, name: 'alembic_version_pkc']
  }

  Note: 'Migration bookkeeping; the current migration chain has one head: 20260929_06.'
}

// Actual database foreign keys use NO ACTION, not ON DELETE CASCADE.
// Soft deletion changes deleted_at and does not invoke these referential actions.
Ref fk_patient_allergies_patient_id_patients: patient_allergies.patient_id > patients.id [delete: no action, update: no action]
Ref fk_patient_allergies_allergen_id_allergens: patient_allergies.allergen_id > allergens.id [delete: no action, update: no action]
Ref fk_patient_conditions_patient_id_patients: patient_conditions.patient_id > patients.id [delete: no action, update: no action]
Ref fk_patient_conditions_condition_id_conditions: patient_conditions.condition_id > conditions.id [delete: no action, update: no action]
Ref fk_patient_notes_patient_id_patients: patient_notes.patient_id > patients.id [delete: no action, update: no action]

Table addresses {
  id uuid [not null, note: 'Application-generated UUID.']
  patient_id uuid [not null]
  address_line_1 varchar(200) [null]
  address_line_2 varchar(200) [null]
  city varchar(100) [null]
  state varchar(100) [null]
  postal_code varchar(20) [null]
  indexes {
    id [pk, name: 'pk_addresses']
    patient_id [unique, name: 'uq_addresses_patient_id']
  }
  Note: 'Patient-owned current mailing address. Each patient has zero or one address; partial addresses are allowed. Soft deletion retains it. Clearing every address field removes it. No address history or household sharing.'
}

Table patient_statuses {
  id uuid [not null, note: 'Application-generated UUID.']
  created_at timestamptz [not null, default: `now()`]
  code varchar(20) [not null]
  name varchar(40) [not null]
  indexes {
    id [pk, name: 'pk_patient_statuses']
    code [unique, name: 'uq_patient_statuses_code']
    name [unique, name: 'uq_patient_statuses_name']
  }
  Note: 'UUID identity with unique codes: active, inactive, discharged. API accepts codes.'
}

Table blood_types {
  id uuid [not null, note: 'Application-generated UUID.']
  created_at timestamptz [not null, default: `now()`]
  code varchar(3) [not null]
  indexes {
    id [pk, name: 'pk_blood_types']
    code [unique, name: 'uq_blood_types_code']
  }
  Note: 'Eight standard ABO/Rh codes are seeded. NULL on patients means not recorded; no unknown sentinel.'
}

Ref fk_addresses_patient_id_patients: addresses.patient_id - patients.id [delete: no action, update: no action]
Ref fk_patients_status_id_patient_statuses: patients.status_id > patient_statuses.id [delete: no action, update: no action]
Ref fk_patients_blood_type_id_blood_types: patients.blood_type_id > blood_types.id [delete: no action, update: no action]
